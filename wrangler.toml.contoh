# Konfigurasi untuk pembangunan setempat (wrangler pages dev) dan deploy melalui CLI.
# Untuk deploy melalui papan pemuka Cloudflare + GitHub, gantikan database_id dengan ID D1 anda.
name = "mpc-pengukuran-produktiviti"
pages_build_output_dir = "public"
compatibility_date = "2025-01-01"

[[d1_databases]]
binding = "DB"
database_name = "mpc-produktiviti"
database_id = "GANTIKAN-DENGAN-ID-D1-ANDA"
